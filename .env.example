# Environment variables for mocal-blog (Gatsby).
# Source of truth for deployed environments: Infisical Cloud, folder /mocal-blog
# (see docs/environment-variables.md). Copy this file to .env for local builds.
# Never commit real values. Every GATSBY_* variable is inlined into the client
# bundle at build time and is therefore public.

# Contentful delivery access token. Required. Read by gatsby-config.ts.
GATSBY_CONTENTFUL_ACCESS_TOKEN=

# Contentful space ID. Required. Read by gatsby-config.ts.
GATSBY_CONTENTFUL_SPACE_ID=

# Google Tag Manager container ID (format: GTM-XXXXXXX). Optional.
# The blog uses its own dedicated container (not "Mocal - Web (Develop|Prod)") for Contentful blog tracking.
# An empty or invalid value disables GTM (no gtm.js request, no build error).
GATSBY_GOOGLE_TAG_MANAGER_ID=

# Supabase project URL (format: https://<project-ref>.supabase.co). Required.
GATSBY_SUPABASE_URL=

# Supabase "publishable" key (anon/public). Required.
# GATSBY_SUPABASE_ANON_KEY is accepted as a legacy fallback (src/lib/supabase.ts).
GATSBY_SUPABASE_PUBLISHABLE_KEY=
